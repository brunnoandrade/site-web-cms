{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "cms: debug server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/cms/node_modules/next/dist/bin/next",
      "args": ["dev", "--port", "3001"],
      "runtimeArgs": ["--inspect"],
      "skipFiles": ["<node_internals>/**"],
      "cwd": "${workspaceFolder}/apps/cms"
    },
    {
      "name": "web: debug full stack",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/web/node_modules/next/dist/bin/next",
      "args": ["dev", "--port", "3000"],
      "runtimeArgs": ["--inspect"],
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "action": "debugWithChrome",
        "killOnServerStop": true,
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "webRoot": "${workspaceFolder}/apps/web"
      },
      "cwd": "${workspaceFolder}/apps/web"
    }
  ]
}
