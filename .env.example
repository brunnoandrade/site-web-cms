# ---------------------------------------------------------------
# Site V2 Digio · docker compose (serviços locais)
# Copie para .env:  cp .env.example .env
# As variáveis de cada app ficam em apps/cms/.env e apps/web/.env.
# ---------------------------------------------------------------

# Postgres
POSTGRES_USER=digio
POSTGRES_PASSWORD=digio
POSTGRES_DB=digio
POSTGRES_PORT=5432

# MinIO (storage S3-compatível)
S3_BUCKET=digio-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Keycloak local (substitui o RH-SSO no desenvolvimento). Console: http://localhost:8080/admin
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Perfil "app" (docker compose --profile app up): portas dos containers do CMS e do site
CMS_PORT=3001
WEB_PORT=3000
