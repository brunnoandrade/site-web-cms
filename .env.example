# ---------------------------------------------------------------
# Site V2 Digio · variáveis de ambiente (CMS + site, um único app)
# Copie para .env:  cp .env.example .env   (ou rode: npm run setup:local)
# O docker compose e o app leem este mesmo arquivo.
# ---------------------------------------------------------------

# --- Serviços locais (docker compose) ---------------------------

# Postgres
POSTGRES_USER=digio
POSTGRES_PASSWORD=digio
POSTGRES_DB=digio
POSTGRES_PORT=5432

# MinIO (storage S3-compatível)
MINIO_API_PORT=9200
MINIO_CONSOLE_PORT=9201

# Keycloak local (substitui o RH-SSO no desenvolvimento). Console: http://localhost:8080/admin
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Perfil "app" (docker compose --profile app up): porta do container do app (site + admin)
APP_PORT=3000

# --- App (Payload CMS em /admin + site público) -----------------

# Postgres (mesmas credenciais e porta acima)
DATABASE_URL=postgres://digio:digio@127.0.0.1:5432/digio

# Segredo para assinar JWT (gere com: openssl rand -hex 32)
PAYLOAD_SECRET=change-me

# URL pública do app (site, /admin e /api), sem barra no final.
# As URLs públicas de cada site vêm das propriedades (tenants): o domínio da requisição
# define qual propriedade é servida.
SERVER_URL=http://localhost:3000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
# Único host que serve o /admin e o /auth/sso (404 nos demais domínios), ex.: admin.digio.com.br.
# Vazio = qualquer domínio (desenvolvimento local). Em HML/PRD, defina.
ADMIN_HOST=

# URL que o app usa para chamar o webhook de revalidação de si mesmo. Padrão: WEB_URL.
WEB_INTERNAL_URL=

# URL do CMS vista pelo navegador (barra de admin, live preview). Embutida no build.
NEXT_PUBLIC_CMS_URL=http://localhost:3000
# GTM/GA4 da propriedade não disparam em localhost (evita sujar o analytics real); true liga para testar as tags.
NEXT_PUBLIC_TRACKING_ON_LOCALHOST=false

# API key de um usuário de serviço, usada só para ler rascunhos no preview.
# Gere em /admin > Users > (usuário) > "Enable API Key".
CMS_API_KEY=

# Segredos de preview e de revalidação do cache
PREVIEW_SECRET=change-me
REVALIDATE_SECRET=change-me

# Segredo para autenticar jobs/cron
CRON_SECRET=change-me

# Storage S3-compatível (MinIO local)
S3_BUCKET=digio-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9200
# MinIO exige path-style (http://host/bucket/key)
S3_FORCE_PATH_STYLE=true
# URL pública de leitura das mídias (bucket ou CDN), sem barra no final.
# O site carrega as imagens daqui, sem passar pelo app.
MEDIA_PUBLIC_URL=http://localhost:9200/digio-media
# Mesmo valor de MEDIA_PUBLIC_URL; o Next o fixa no build (lista de hosts de imagem).
NEXT_PUBLIC_MEDIA_URL=http://localhost:9200/digio-media
# Só em desenvolvimento local: permite o next/image otimizar imagens do MinIO em localhost
IMAGES_ALLOW_LOCAL_IP=true

# Autenticação do admin: dois autenticadores independentes (ver docs/gaps-soad.md)
# Login local (e-mail e senha). Em PRD: false (SoAD: sem usuário local em produção).
AUTH_LOCAL_ENABLED=true
# SSO corporativo (RH-SSO/Keycloak, OIDC Authorization Code + PKCE)
AUTH_SSO_ENABLED=true
OIDC_ISSUER=http://localhost:8080/realms/digio
OIDC_CLIENT_ID=digio-cms
OIDC_CLIENT_SECRET=digio-cms-local-secret
# Papel do realm que torna o usuário super admin. Grupos /tenants/<propriedade>/<admin|editor|seo>
# dão papéis por propriedade.
OIDC_SUPER_ADMIN_ROLE=cms-super-admin
# Duração da sessão SSO no CMS, em horas
SSO_SESSION_HOURS=8
# De quanto em quanto tempo o CMS reconfere o usuário no RH-SSO (grupo removido ou usuário
# desabilitado encerram a sessão do CMS). Em segundos.
SSO_REVALIDATE_SECONDS=300
