{
  "name": "cms",
  "version": "1.0.0",
  "private": true,
  "description": "Site V2 Digio: Payload CMS (admin e API)",
  "type": "module",
  "scripts": {
    "blog:migrate": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/migrate-wordpress.ts",
    "bootstrap:dev": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/bootstrap-dev.ts",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --port 3001",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "redirects:import": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/import-redirects.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start --port 3001",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts --project int",
    "test:sso": "python3 scripts/sso-smoke.py",
    "test:unit": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts --project unit --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@digio/payload-types": "workspace:*",
    "@digio/routes": "workspace:*",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-form-builder": "3.90.2",
    "@payloadcms/plugin-multi-tenant": "3.90.2",
    "@payloadcms/plugin-nested-docs": "3.90.2",
    "@payloadcms/plugin-redirects": "3.90.2",
    "@payloadcms/plugin-search": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "cross-env": "^7.0.3",
    "csv-parse": "7.0.2",
    "dotenv": "16.4.7",
    "graphql": "^16.8.2",
    "jose": "^6.2.12",
    "jsdom": "28.0.0",
    "next": "16.3.3",
    "openid-client": "6.8.8",
    "payload": "3.90.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.4.2",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  }
}
