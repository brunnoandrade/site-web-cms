# ---------------------------------------------------------------
# Site público (Next.js) · apps/web
# Copie para .env:  cp apps/web/.env.example apps/web/.env
# ---------------------------------------------------------------

# As URLs públicas de cada site vêm das propriedades (tenants) no CMS:
# o domínio da requisição define qual propriedade é servida.

# CMS: URL usada pelo servidor do site para ler conteúdo (em containers: http://cms:3001)
CMS_URL=http://localhost:3001
# CMS: URL vista pelo navegador (barra de admin, live preview, formulários)
NEXT_PUBLIC_CMS_URL=http://localhost:3001

# API key de um usuário de serviço do CMS, usada só para ler rascunhos no preview.
# Gere em /admin > Users > (usuário) > "Enable API Key".
CMS_API_KEY=

# Segredos compartilhados com o CMS: têm que ser iguais em apps/cms/.env
PREVIEW_SECRET=change-me
REVALIDATE_SECRET=change-me

# Storage público das mídias (mesmo valor de MEDIA_PUBLIC_URL no CMS)
NEXT_PUBLIC_MEDIA_URL=http://localhost:9000/digio-media
# Só em desenvolvimento local: permite o next/image otimizar imagens do MinIO em localhost
IMAGES_ALLOW_LOCAL_IP=true
