{
  "name": "site-web-digio",
  "private": true,
  "description": "Site V2 Digio: monorepo com o CMS (Payload) e o site público (Next.js)",
  "type": "module",
  "scripts": {
    "build": "npm run build -w cms && npm run build -w web",
    "dev": "concurrently -n cms,web -c blue,green \"npm run dev -w cms\" \"npm run dev -w web\"",
    "dev:cms": "npm run dev -w cms",
    "dev:web": "npm run dev -w web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:types": "npm run generate:types -w cms",
    "lint": "npm run lint --workspaces --if-present",
    "test:int": "npm run test:int -w cms",
    "test:scripts": "vitest run scripts",
    "test:unit": "npm run test:unit --workspaces --if-present && npm run test:scripts",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p scripts/tsconfig.json",
    "validate-urls": "tsx scripts/validate-urls.ts"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "concurrently": "^9.2.1",
    "prettier": "^3.4.2",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  },
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "undici": "^7.29.1",
    "source-map-js": ">=1.2.2",
    "dompurify": ">=3.4.16",
    "sharp": ">=0.35.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.18.20": true,
    "unrs-resolver@1.12.2": true
  }
}
