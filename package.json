{
  "name": "site-web-digio",
  "private": true,
  "description": "Site V2 Digio: site público e CMS (Payload) em um único app Next.js",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --port 3000",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start --port 3000",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc -p scripts/tsconfig.json",
    "setup:local": "bash scripts/setup-local.sh",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "test:unit": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts --project unit",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts --project int",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:sso": "python3 scripts/sso-smoke.py",
    "validate-urls": "tsx scripts/validate-urls.ts",
    "uber:seo": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/uber-seo.ts",
    "uber:home": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/update-uber-home.ts",
    "uber:pages": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/uber-pages.ts",
    "urls:normalize": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/normalize-urls.ts",
    "uber:help": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/uber-help.ts",
    "uber:blog": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/uber-blog.ts",
    "blog:migrate": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/migrate-wordpress.ts",
    "bootstrap:dev": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/bootstrap-dev.ts",
    "tenants:profile": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/tenant-profiles.ts",
    "users:local": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/local-users.ts"
  },
  "dependencies": {
    "@payloadcms/admin-bar": "3.90.2",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-multi-tenant": "3.90.2",
    "@payloadcms/plugin-nested-docs": "3.90.2",
    "@payloadcms/plugin-search": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "csv-parse": "7.0.2",
    "dotenv": "16.4.7",
    "graphql": "^16.8.2",
    "jose": "^6.2.12",
    "jsdom": "28.0.0",
    "lucide-react": "0.563.0",
    "next": "16.3.8",
    "next-sitemap": "^4.2.3",
    "openid-client": "6.8.8",
    "payload": "3.90.2",
    "prism-react-renderer": "^2.3.1",
    "qs-esm": "8.0.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.71.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/react": "16.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.28",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.18",
    "tsx": "4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10"
  },
  "packageManager": "npm@11.19.0",
  "overrides": {
    "undici": "^7.29.1",
    "source-map-js": ">=1.2.2",
    "dompurify": ">=3.4.16",
    "sharp": "$sharp"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.18.20": true,
    "unrs-resolver@1.12.2": true
  }
}
